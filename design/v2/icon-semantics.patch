+/* 图标态：默认 28×28 只显示图标，悬停就地展开文字（不换行、不跳位） */
+.app--next .sb-btn--icon {
+  width: 28px;
+  height: 28px;
+  padding: 0;
+  justify-content: center;
+  gap: 0;
+  transition: width 0.13s ease, padding 0.13s ease, gap 0.13s ease;
+}
+
+.app--next .sb-btn--icon > span {
+  display: none;
+}
+
+.app--next .sb-btn--icon .ic {
+  width: 15px;
+  height: 15px;
+}
+
+.app--next .sb-btn--icon:hover {
+  width: auto;
+  padding: 0 9px;
+  gap: 5px;
+}
+
+.app--next .sb-btn--icon:hover > span {
+  display: inline;
+}
