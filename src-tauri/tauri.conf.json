{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shellora",
  "version": "1.0.9",
  "identifier": "com.shellora.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Shellora",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU2NThCNDZEOUNGNDZERDMKUldUVGJmU2NiYlJZVmpJU2s3bWZTNElJNzNJc0E1dDdaUnRubmk5VjcraGVYbXFiK1dOV3NYczUK",
      "endpoints": [
        "https://github.com/yunyu697/shellora/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Shellora",
    "copyright": "Copyright (c) 2026 Shellora contributors",
    "category": "DeveloperTool",
    "shortDescription": "SSH terminal and dual-pane SFTP manager",
    "longDescription": "Cross-platform SSH terminal with SFTP dual-pane file manager.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}
